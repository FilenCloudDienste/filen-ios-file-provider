            <ActionContent
               title = "Run Script"
               scriptText = "# Builds the universal macOS Rust xcframework and regenerates the UniFFI bindings.&#10;export SDKROOT=$(xcrun --sdk macosx --show-sdk-path)&#10;export CC=$(xcrun --find clang)&#10;export CXX=$(xcrun --find clang++)&#10;unset XROS_DEPLOYMENT_TARGET&#10;unset MACOSX_DEPLOYMENT_TARGET&#10;unset TVOS_DEPLOYMENT_TARGET&#10;unset WATCHOS_DEPLOYMENT_TARGET&#10;unset DRIVERKIT_DEPLOYMENT_TARGET&#10;unset SWIFT_DEBUG_INFORMATION_FORMAT&#10;unset SWIFT_DEBUG_INFORMATION_VERSION&#10;&#10;[ -f ~/.bash_profile ] &amp;&amp; . ~/.bash_profile&#10;cd $SRCROOT&#10;/bin/sh ./build-rust.sh --macos --rust-dir ../filen-rs --rust-crate-name filen-mobile-native-cache&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "FE5800012E5B000000000001"
                     BuildableName = "FilenFileProvider.appex"
                     BlueprintName = "FilenFileProviderMac"
                     ReferencedContainer = "container:FilenFileProvider.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
