      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "# Builds the Rust xcframework and regenerates the UniFFI bindings the test bundle compiles.&#10;export SDKROOT=$(xcrun --sdk macosx --show-sdk-path)&#10;export CC=$(xcrun --find clang)&#10;export CXX=$(xcrun --find clang++)&#10;unset XROS_DEPLOYMENT_TARGET&#10;unset MACOSX_DEPLOYMENT_TARGET&#10;unset TVOS_DEPLOYMENT_TARGET&#10;unset WATCHOS_DEPLOYMENT_TARGET&#10;unset DRIVERKIT_DEPLOYMENT_TARGET&#10;unset SWIFT_DEBUG_INFORMATION_FORMAT&#10;unset SWIFT_DEBUG_INFORMATION_VERSION&#10;&#10;source ~/.bash_profile&#10;cd $SRCROOT&#10;/bin/sh ./build-rust.sh --rust-dir ../filen-rs --rust-crate-name filen-mobile-native-cache&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "FE5700A12E5B000000000001"
                     BuildableName = "FilenFileProviderTests.xctest"
                     BlueprintName = "FilenFileProviderTests"
                     ReferencedContainer = "container:FilenFileProvider.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "NO"
            buildForProfiling = "NO"
            buildForArchiving = "NO"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "FE5700A12E5B000000000001"
